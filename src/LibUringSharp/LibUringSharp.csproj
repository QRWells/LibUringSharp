<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>

        <Title>QRWells.LibUringSharp</Title>
        <PackageId>QRWells.LibUringSharp</PackageId>
        <Copyright>Copyright © Qirui Wang 2023</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Qirui Wang</Authors>
        <Description>A C# wrapper for the Linux io_uring API.</Description>
        <PackageProjectUrl>https://github.com/QRWells/LibUringSharp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/QRWells/LibUringSharp</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>io_uring</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <NeutralLanguage>en-US</NeutralLanguage>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
        <AssemblyName>QRWells.LibUringSharp</AssemblyName>
        <RootNamespace>QRWells.LibUringSharp</RootNamespace>
        <Company>QRWells</Company>

    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="QRWells.LibUringSharp.Test" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

</Project>
